# Địa chỉ Backend để lấy dữ liệu tương tác thật (bỏ trống = chỉ dùng dữ liệu giả lập)
BACKEND_URL=http://localhost:4000
# PHẢI trùng với INTERNAL_API_KEY của Backend
INTERNAL_API_KEY=dev-internal-key
# Tự huấn luyện lại từ dữ liệu thật mỗi khi service khởi động
AUTO_RETRAIN_ON_START=true
# Giữ dữ liệu giả lập làm nền khi dữ liệu thật còn ít (đặt false khi đã có nhiều dữ liệu thật)
USE_SYNTHETIC_BASE=true
