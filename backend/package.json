{
  "name": "sttn-backend",
  "version": "2.0.0",
  "description": "Backend Service (Node.js/Express) - STTN Recommendation System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --config nodemon.json src/server.js",
    "seed": "node src/db/reseed.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "qs": "^6.14.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "js,mjs",
    "ignore": [
      "src/db/**",
      "src/db/*",
      "**/*.json",
      "**/*.db*",
      "node_modules"
    ],
    "delay": 1000
  }
}
