PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
ML_SERVICE_URL=http://localhost:8001

# Khoá dùng chung giữa Backend và ML service (ML đọc dữ liệu thật qua /api/internal/export)
INTERNAL_API_KEY=dev-internal-key

# Để TRỐNG = dùng SQLite (chạy local). Điền URL = dùng PostgreSQL.
# Ví dụ local: postgresql://postgres:postgres@localhost:5432/sttn
DATABASE_URL=
# Đặt true nếu DB bên ngoài yêu cầu SSL (Render external URL, Neon, Supabase...)
DATABASE_SSL=false

# (tuỳ chọn) mật khẩu admin lần đầu, mặc định admin123
ADMIN_PASSWORD=
# (tuỳ chọn) giới hạn domain frontend, ngăn cách bằng dấu phẩy
CORS_ORIGIN=
